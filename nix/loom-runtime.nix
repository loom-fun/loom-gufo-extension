# The Loom runtime this extension links. Loom's text model
# layer (the kernels and programs of a Loom package, without loom-serve's
# scheduler, caches or HTTP) behind a small C API, `libloom_text_embed.so`,
# plus loom-serve for comparison. Built from the hrx-system release that
# loom-fun packages target (hrx-loom 0.3.0).
{
  lib,
  fetchFromGitHub,
  fetchurl,
  writeText,
  cmake,
  git,
  ninja,
  python3,
  clangStdenv,
  # The embedding library's sources: a directory with `CMakeLists.txt`,
  # added to Loom's serve tree.
  embed,
  # Also build loom-serve and loom-fetch (for side-by-side comparisons);
  # the extension needs only the library.
  withTools ? false,
}:

let
  # hrx-system v0.3.0, the release of hrx-loom 0.3.0.
  version = "0.3.0";
  revision = "e2c41a720363911c04606ce0f4417e2d55630352";

  src = fetchFromGitHub {
    owner = "ROCm";
    repo = "hrx-system";
    rev = revision;
    hash = "sha256-x2eu2g3QopK3OOX4SmeiTGgUhRE4llkC+HvyMny7fQc=";
  };

  # Every download pinned in MODULE.cmake.lock and Loom's ISA XML descriptor, one
  # fetchurl each (hrx-deps.nix, generated by hrx-deps.py), so the configure step
  # runs without network access. The map sends each pinned URL to its store path.
  deps = import ./hrx-deps.nix { inherit fetchurl; };
  depsMap = writeText "hrx-deps.json" (
    builtins.toJSON (
      builtins.listToAttrs (
        builtins.concatMap (
          dep:
          map (url: {
            name = url;
            value = "${dep.file}";
          }) dep.urls
        ) deps
      )
    )
  );

  loomTools = [ "loom-serve" ];
in
clangStdenv.mkDerivation {
  pname = "loom-runtime";
  inherit version src;

  postPatch = ''
    python3 ${./hrx-deps.py} rewrite . ${depsMap}
  '';

  nativeBuildInputs = [
    cmake
    ninja
    git
    python3
  ];

  # Loom 0.3.0 drives AMD GPUs through its own native driver (libamdf): no ROCm
  # runtime or device toolchain is involved. The library is defined by
  # loom_text_embed.cmake, which HRX's CMake includes once its targets exist.
  cmakeFlags = [
    "-DCMAKE_BUILD_TYPE=Release"
    # Loom's static libraries link into the shared embedding library.
    "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
    "-DIREE_ENABLE_POSITION_INDEPENDENT_CODE=ON"
    "-DIREE_BUILD_TESTS=OFF"
    "-DIREE_ENABLE_WERROR_FLAG=OFF"
    "-DLIBHRX_BUILD=OFF"
    "-DIREE_HAL_DRIVER_AMD_XDNA=OFF"
    "-DLOOM_TARGET_ALL_AMD_GPU=ON"
    "-DIREE_CMAKE_TRY_FILE=${embed}/loom_text_embed.cmake"
  ];

  ninjaFlags = [
    "loom_text_embed"
  ]
  ++ lib.optionals withTools loomTools;

  installPhase = ''
    runHook preInstall
    install -Dm755 libloom_text_embed.so $out/lib/libloom_text_embed.so
    install -Dm644 ${embed}/loom_text_embed.h $out/include/loom_text_embed.h
    mkdir -p $out/lib/pkgconfig
    cat > $out/lib/pkgconfig/loom-text-embed.pc <<EOF
    prefix=$out
    Name: loom-text-embed
    Description: Loom text model layer for embedding
    Version: ${version}
    Libs: -L$out/lib -Wl,-rpath,$out/lib -lloom_text_embed
    Cflags: -I$out/include
    EOF
  ''
  + lib.optionalString withTools ''
    for tool in ${lib.concatStringsSep " " loomTools}; do
      install -Dm755 loom/src/loom/tools/$tool/$tool $out/bin/$tool
    done
    # loom-fetch is the pure-Python model acquisition tool.
    mkdir -p $out/share/loom
    cp -r $src/loom/py $out/share/loom/py
    cat > $out/bin/loom-fetch <<EOF
    #!${python3}/bin/python3
    import sys
    sys.path.insert(0, "$out/share/loom/py")
    from loom.model.fetch_main import main
    sys.exit(main())
    EOF
    chmod +x $out/bin/loom-fetch
  ''
  + ''
    runHook postInstall
  '';

  passthru = { inherit deps depsMap revision; };

  meta = {
    description = "Loom ${version} text model runtime for the Gufo loom extension (experimental)";
    homepage = "https://github.com/ROCm/hrx-system";
    license = with lib.licenses; [
      asl20
      llvm-exception
    ];
    platforms = [ "x86_64-linux" ];
  };
}
