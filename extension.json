{
  "schema": 1,
  "name": "loom",
  "version": "0.2.0",
  "api_version": ">= 0.3.16",
  "entry": "loom_register",
  "registration_target": "gufo_loom",
  "depends": [],
  "platforms": [
    "linux"
  ],
  "providers": [
    {
      "id": "loom-text",
      "capability": "text_generation",
      "keys": [
        "manifest:loom"
      ],
      "model_ids": [],
      "target": "gufo_loom",
      "entry": "loom_text_provider_register"
    }
  ],
  "options": [
    {
      "name": "--loom-device",
      "type": "string",
      "commands": [
        "serve",
        "prompt",
        "chat",
        "bench"
      ],
      "providers": [
        "loom-text"
      ],
      "help": "Loom device URI (default: amdgpu://?completion_spin_ns=4294967295)"
    },
    {
      "name": "--loom-memory-bytes",
      "type": "integer",
      "commands": [
        "serve",
        "prompt",
        "chat",
        "bench"
      ],
      "providers": [
        "loom-text"
      ],
      "help": "Budget for an elastic Loom memory pool (weights and state); default: none, a fixed pool committed at load"
    },
    {
      "name": "--loom-logits",
      "type": "string",
      "commands": [
        "serve",
        "prompt",
        "chat",
        "bench"
      ],
      "providers": [
        "loom-text"
      ],
      "help": "Logits readback for host sampling (grammars, logprobs, min-p, penalties): auto, on or off (default: auto, on when the package declares it)"
    },
    {
      "name": "--loom-preset",
      "type": "string",
      "commands": [
        "serve",
        "prompt",
        "chat",
        "bench"
      ],
      "providers": [
        "loom-text"
      ],
      "help": "Preset of the Loom package to serve (default: the package's own)"
    }
  ],
  "packages": [
    {
      "pkg_config": "loom-text-embed"
    }
  ],
  "targets": {
    "gufo_loom": {
      "requires": []
    }
  },
  "licenses": [
    "LICENSE"
  ]
}
